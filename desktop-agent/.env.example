# LLM Configuration
LLM_API_KEY=freellmapi-YOUR-API-KEY
LLM_MODEL=openai/gpt-4o
LLM_BASE_URL=https://server-llm-1.onrender.com/v1

# Agent Server
PORT=6901

# CUA Sandbox Mode (choose based on client setup)
# - auto: Docker if available, else QEMU (RECOMMENDED)
# - docker: Full desktop with GUI (~4GB download, fast, requires Docker)
# - qemu: Full desktop without Docker (~500MB download, slower, no Docker required)
# - minimal: Headless Ubuntu (~200MB download, terminal-only, minimal resources)
CUA_MODE=auto

# Stream Quality (FPS and compression)
# Defaults: 10 FPS, 40% quality (conservative for low-resource setups)
# Increase for faster connections: STREAM_FPS=15, STREAM_QUAL=50
STREAM_FPS=10
STREAM_QUAL=40
