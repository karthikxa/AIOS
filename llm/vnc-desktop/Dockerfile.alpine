FROM alpine:latest

RUN apk add --no-cache \
    xvfb \
    x11vnc \
    fluxbox \
    xterm \
    novnc \
    netcat-openbsd \
    bash

RUN mkdir -p ~/.vnc && \
    x11vnc -storepasswd "" ~/.vnc/passwd 2>/dev/null || true

COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 5900
EXPOSE 6080

CMD ["/start.sh"]
